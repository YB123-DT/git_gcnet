{
  "base_model": "LSTM",
  "batch_size": 32,
  "dataset": "IEMOCAPSix",
  "device": "cuda",
  "dropout": 0.5,
  "epochs": 100,
  "evaluate_test": true,
  "evaluation_protocol": "official",
  "fold": 5,
  "gradient_clip_norm": 1.0,
  "hidden": 200,
  "learning_rate": 0.001,
  "seed": 66,
  "time_attention": false,
  "train_rate_mode": "stratified",
  "validation_fraction": 0.1,
  "weight_decay": 1e-05,
  "window_future": 2,
  "window_past": 2
}
