{
  "base_model": "LSTM",
  "batch_size": 32,
  "dataset": "CMUMOSI",
  "device": "cuda",
  "dropout": 0.5,
  "ema_tau": 0.996,
  "epochs": 100,
  "evaluation_protocol": "official",
  "fold": 1,
  "fusion_type": "raw-residual",
  "gradient_clip_norm": 1.0,
  "hidden": 200,
  "jepa_weight": 0.1,
  "latent_dim": 256,
  "learning_rate": 0.001,
  "num_experts": 4,
  "predictor_dropout": 0.1,
  "projector_dropout": 0.1,
  "seed": 68,
  "temperature": 0.03,
  "time_attention": false,
  "top_k": 2,
  "validation_fraction": 0.1,
  "weight_decay": 1e-05,
  "window_future": 2,
  "window_past": 2
}
