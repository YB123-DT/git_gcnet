{
  "batch_size": 32,
  "checkpoint_selection": "validation_weighted_f1",
  "dataset": "CMUMOSI",
  "device": "cuda",
  "dropout": 0.5,
  "epochs": 100,
  "excluded_components": [
    "audio",
    "visual",
    "gcnet",
    "jepa",
    "mmoe",
    "completion"
  ],
  "gradient_clip_norm": 1.0,
  "hidden_dim": 200,
  "learning_rate": 0.001,
  "seed": 70,
  "test_every_epoch": true,
  "text_feature": "deberta-large-4-UTT",
  "variant": "strict-text-only-bigru",
  "weight_decay": 1e-05
}
